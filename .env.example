# Email bot server (npm run server). Copy to .env and fill in.
PORT=8787

# Leave SMTP_HOST empty to stay in preview mode: emails are written to server/outbox as .eml files.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SAHAS Foundation <your-address@example.com>"

# Payments are demo-only, so real delivery is limited to these addresses (comma separated).
DEMO_ALLOWED_RECIPIENTS=

# Required when SMTP is set: your email provider's inbound webhook must send this in the x-webhook-secret header.
INBOUND_SECRET=

# Browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5601,http://localhost:5173,https://alxnder10.github.io
